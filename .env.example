# Copiá este archivo a .env y completá los valores. Ninguna variable acá
# es obligatoria para correr en modo Discovery sin login -- solo hacen
# falta para habilitar el login con EVE. Ver docs/SETUP.md para el paso a
# paso completo (incluye cómo registrar la app en developers.eveonline.com).
#
# ⚠️ NUNCA subas un .env real (con valores reales) a un repositorio
# público -- por eso .env está en .gitignore. Este archivo (.env.example)
# sí se sube, pero solo tiene placeholders, nunca secretos reales.

# --- Sesión propia (obligatorias para que el login funcione) ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
QUARTERMASTER_SESSION_SECRET=

# Generar con: python -c "from infrastructure.security.token_encryption import generate_key; print(generate_key())"
QUARTERMASTER_ENCRYPTION_KEY=

# --- EVE SSO (obligatorias para el login con EVE) ---
# Ver docs/SETUP.md paso 2 -- se obtienen registrando una app en
# https://developers.eveonline.com
EVE_SSO_CLIENT_ID=
EVE_SSO_CLIENT_SECRET=

# --- Panel de administración (opcional) ---
# Cualquier string secreto elegido a mano -- protege GET /api/admin/stats.
# Si no se configura, ese endpoint devuelve 503 en vez de exponer datos.
QUARTERMASTER_ADMIN_KEY=

# --- NiceGUI (opcional, solo si usás esa UI) ---
# Cualquier string secreto elegido a mano -- si no se configura, NiceGUI
# genera uno random en cada arranque (funciona, pero invalida todas las
# sesiones activas cada vez que se reinicia el proceso).
QUARTERMASTER_UI_STORAGE_SECRET=

# --- Puertos (opcional, tienen defaults razonables) ---
# QUARTERMASTER_UI_PORT=8502
